# Example: copy to `.env` next to docker-compose.yml before `docker compose up`
# All values are overridable at runtime.

# --- Security (CHANGE BEFORE FIRST BOOT) ---
JWT_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
ADMIN_EMAIL=admin@thinkcloud.in
ADMIN_PASSWORD=ChangeMe@123

# --- IPAM behavior ---
# false = real ICMP ping + reverse DNS against your subnets (production)
# true  = deterministic simulated ping/DNS (for demos or when the host cannot route)
IPAM_SIMULATED=false
IPAM_SWEEP_INTERVAL_MIN=15
IPAM_HOLD_MINUTES=10
IPAM_LONG_HELD_DAYS=90

# --- TLS ---
# CN and SAN embedded in the auto-generated self-signed cert
TLS_CN=10.1.2.185
TLS_SAN=IP:10.1.2.185

# --- Frontend build-time backend URL ---
# Leave empty for same-origin (recommended): browser calls https://<this-host>/api/*
# Set to a full URL only if you host the API on a different host/port.
REACT_APP_BACKEND_URL=
